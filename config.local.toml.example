# config.local.toml: this Mac's own Scranton settings (not in git).
#
#   cp config.local.toml.example config.local.toml
#
# Keep your changes here instead of in config.toml, so "Update now" keeps working.

# Phone access through Tailscale Serve (see README):
# [server]
# allowed_origins = ["https://mac-mini.tail1234.ts.net"]

# Team-wide:
# [team]
# owner = "Lu"
# permissions = "full"      # or "ask"

# Per teammate (only autostart, cwd and permissions can be changed here):
# [agents.growth]
# autostart = true
#
# [agents.visual]
# permissions = "ask"       # get the normal approval prompts back for this one
